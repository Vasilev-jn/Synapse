# Telegram bot
AVITO_TG_BOT_TOKEN=
AVITO_TG_CHAT_ID=
AVITO_TG_CHAT_IDS=
AVITO_TG_ARTEM_CHAT_ID=

# LLM / Polza AI
POLZA_API_KEY=
OPENROUTER_API_KEY=

# CRM API used by marketplace monitor
CRM_MARKET_API_URL=http://127.0.0.1:8001/api/market/imports/avito
CRM_MARKET_EVALUATE_API_URL=http://127.0.0.1:8001/api/market/evaluate-avito-listing
CRM_MARKET_EVALUATE_TIMEOUT_SECONDS=30
CRM_MARKET_API_TOKEN=

# Optional CRM import auth. Leave empty if CRM has no MARKET_IMPORT_TOKEN.
MARKET_IMPORT_TOKEN=

# PostgreSQL for CRM
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=crm_inventory
DB_USER=postgres
DB_PASSWORD=

# Optional proxy rotation links for marketplace monitor.
# You can also use monitor_local_settings.json; do not commit real keys.
AVITO_PROXY_ROTATION_URLS=
