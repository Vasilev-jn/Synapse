    "search_results_min_open_tap_y": 360,
    "search_results_max_open_tap_y": 1780,
    "search_results_min_visible_card_height": 420,
    "search_results_min_visible_card_ratio": 0.55,
    "recover_to_search_results_back_presses": 3,
    "max_consecutive_search_failures": 3
  },
  "refresh": {
    "description": "Pull-to-refresh on search results. Edit regions and duration here.",
    "start_region": {
      "x1": 485,
      "y1": 690,
      "x2": 595,
      "y2": 820
    },
    "end_region": {
      "x1": 485,
      "y1": 1220,
      "x2": 595,
      "y2": 1380
    },
    "duration_ms": 1050,
    "jitter_px": 0
  },
  "integrations": {
    "llm": {
      "enabled": true,
      "provider": "polza",
      "model": "qwen/qwen3-30b-a3b-instruct-2507",
      "items_max_tokens": 4096,
      "items_timeout_seconds": 60,
      "heavy_routing_enabled": true,
      "heavy_model": "google/gemma-3-27b-it",
      "heavy_fallback_model": "",
      "heavy_items_max_tokens": 8192,
      "heavy_items_timeout_seconds": 240,
      "price_line_chunking_enabled": true,
      "price_line_min_count": 12,
      "price_line_chunk_size": 30,
      "price_line_max_chunks": 6
    },
    "telegram": {
      "enabled": true
    }
  },
  "profit_rules": {
    "games": {
      "discount_from_shop_median_percent": 20,
      "min_profit_per_disc": 300,
      "sale_commission_percent": 9,
      "fixed_cost_per_disc": 50,
      "round_price_step_rub": 50,
      "round_quick_sell_price": "nearest",
      "round_max_buy_price": "floor",
      "low_price_observation_threshold": 3
    }
  },
  "safety": {
    "bottom_danger_zone_percent": 0.18,
    "bottom_danger_zone_margin_px": 120,
    "read_more_micro_scroll_px": 260,
    "read_more_micro_scroll_duration_ms": 360,
    "description_missing_micro_scroll_px": 110,
    "description_missing_micro_scroll_duration_ms": 260,
    "allowed_bottom_action_names": [],
    "forbidden_button_texts": [
      "Написать",
      "Позвонить",
      "Купить",
      "Оформить",
      "Оформить доставку",
      "Предложить скидку",
      "Попросить скидку",
      "В корзину",
      "Добавить в корзину",
      "Избранное",
      "В избранное",
      "Забронировать",
      "Заказать",
      "Оплатить"
