{
  "version": 1,
  "screen_size": {
    "width": 1080,
    "height": 2280
  },
  "timings": {
    "screen_settle_seconds": 1.5,
    "after_tap_seconds": 2.0,
    "after_swipe_seconds": 2.5,
    "after_refresh_seconds": 4.5,
    "between_cards_seconds": 2.0,
    "between_cycles_seconds": 45.0,
    "xml_after_screen_change_seconds": 1.3,
    "between_cycles_random_extra_seconds": {
      "min": 1.0,
      "max": 15.0
    }
  },
  "pipeline": {
    "max_cards_per_cycle": 2,
    "link_monitor_scan_rows": 2,
    "max_scrolls_inside_listing": 7,
    "max_refreshes_per_run": 1,
    "stop_if_screen_unknown": true,
    "require_search_results_before_refresh": true,
    "require_listing_before_extract_description": true,
    "allow_read_more_fallback_tap": false,
    "description_missing_micro_scroll_attempts": 2,
    "description_summary_threshold_chars": 500,
    "search_results_visible_top_y": 330,
